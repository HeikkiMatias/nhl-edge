# Copy to .env and fill in. .env is gitignored, and Claude Code is denied reading it.
# The same names are GitHub Actions secrets (docs/plan.md section 8).

# The Odds API, free tier: 500 credits a month (odds-snapshots)
ODDS_API_KEY=

# Supabase serving database (ingest, odds, predict). The service role key stays server-side.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 lake (ingest, predict, backtest)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Not read by the app. Start Claude Code with ALLOW_PAID_ODDS=1 in the environment to let the
# guard-bash hook allow paid historical odds calls.
